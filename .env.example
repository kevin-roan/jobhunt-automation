# deedy-automation environment
#
# Copy to .env and edit. Every value below is optional: the defaults shown are
# what the code uses when the variable is unset. Nothing here is sent anywhere -
# the whole stack runs on this host.
#
#   cp .env.example .env
#
# Only the variables in this file are read by the application. Anything else you
# add is ignored.

# ---------------------------------------------------------------------------
# Runtime (read by apps/api/src/config/env.ts)
# ---------------------------------------------------------------------------

# Runtime mode: development | production | test. Affects logging and error detail.
NODE_ENV=production

# Interface the API binds to. The application DEFAULTS to 127.0.0.1, because the
# API is unauthenticated and drives a local model, a browser and a TeX engine —
# none of which should be reachable from the LAN. Only widen it deliberately.
# Containers set 0.0.0.0 because there the published port is the boundary.
HOST=127.0.0.1

# Port the API listens on inside the process/container.
PORT=8080

# Root directory for all persisted state: SQLite database, artifacts, documents,
# browser profiles, backups, plugins and the generated encryption key.
DATA_DIR=./data

# Log verbosity: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# Directory holding the compiled dashboard, served at "/".
WEB_DIR=./public

# Comma-separated list of allowed CORS origins. Only needed when the Vite dev
# server runs separately from the API; the packaged build serves both from one origin.
CORS_ORIGINS=http://localhost:5173

# Set to true (or 1) to disable the background worker and scheduler. Useful for
# tests, CLI runs and read-only inspection of an existing database.
DISABLE_WORKERS=false

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# 32-byte key, hex encoded (64 characters), used to encrypt secret settings such
# as job-board credentials. Generate one with:
#
#   openssl rand -hex 32
#
# If left empty, the app generates a key on first boot and stores it at
# $DATA_DIR/.encryption-key (mode 0600). Set it explicitly when you want the key
# managed outside DATA_DIR, e.g. for containers with ephemeral volumes.
#
# WARNING: losing this key makes every stored secret permanently unrecoverable.
# There is no recovery path and no backup copy anywhere else. Back it up, and
# never change it while encrypted settings exist.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Docker Compose only (read by docker-compose.yml, not by the app)
# ---------------------------------------------------------------------------

# Host port mapped to the app container's port 8080.
APP_PORT=8080

# Host port mapped to the optional Ollama container. Started with:
#   docker compose --profile llm up -d
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# Frontend tooling only (read by apps/web configs, not by the app at runtime)
# ---------------------------------------------------------------------------

# API origin the Vite dev server proxies to. Default: http://localhost:8080
# VITE_API_URL=http://localhost:8080

# Point the Playwright e2e suite at an already-running instance instead of
# letting it start its own dev server.
# E2E_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Host prerequisites (no env vars — listed here because they change behaviour)
# ---------------------------------------------------------------------------
#
# LaTeX resume rendering
#   Resumes are LaTeX compiled to PDF with the deedy-resume-openfont class.
#   The class uses fontspec, so it needs XeLaTeX — pdflatex cannot build it.
#     Debian/Ubuntu: apt install texlive-xetex texlive-latex-extra \
#                        texlive-fonts-recommended latexmk
#     Arch:          pacman -S texlive-xetex texlive-latex texlive-latexextra \
#                        texlive-fontsrecommended texlive-binextra
#   Or drop a `tectonic` binary on PATH. Without any engine the API still runs:
#   the .tex is saved and every compile reports the engine is missing.
#
# LaTeX sandbox (strongly recommended)
#   Install `bubblewrap`. Resume LaTeX is attacker-influenced and TeX is
#   Turing-complete, so the regex denylist in front of the engine is a filter,
#   not a boundary — bubblewrap's mount namespace is what actually prevents a
#   document reading DATA_DIR and returning the encryption key inside the PDF.
#   The API logs loudly at startup when it is absent. In Docker this also needs
#   the security_opt entries in docker-compose.yml.
#
# Browser-driven collectors
#   LinkedIn and Indeed drive a real browser; the HTTP-only collectors
#   (Greenhouse, Lever, Ashby, …) do not. Run once:
#     npx playwright install chromium
#   Without it those two sources fail with a message naming this command.
#
# VPN exit location (optional)
#   Settings > VPN can switch which country the collectors browse from. The
#   `protonvpn` backend needs the Proton VPN Linux client installed and signed
#   in on the HOST — it drives NetworkManager, so it does not work from inside
#   the container. nmcli / wg_quick / command backends are available for a
#   tunnel you already manage.
