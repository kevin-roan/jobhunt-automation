# deedy-automation environment
#
# Copy to .env and edit. Every value below is optional: the defaults shown are
# what the code uses when the variable is unset. Nothing here is sent anywhere -
# the whole stack runs on this host.
#
#   cp .env.example .env
#
# Only the variables in this file are read by the application. Anything else you
# add is ignored.

# ---------------------------------------------------------------------------
# Runtime (read by apps/api/src/config/env.ts)
# ---------------------------------------------------------------------------

# Runtime mode: development | production | test. Affects logging and error detail.
NODE_ENV=production

# Interface the API binds to. The application DEFAULTS to 127.0.0.1. /api now
# requires a bearer token, but that is one shared secret in front of a service
# that drives a local model, a signed-in browser and a TeX engine — so the
# loopback binding stays as the second layer. Only widen it deliberately.
# Containers set 0.0.0.0 because there the published port is the boundary.
HOST=127.0.0.1

# Port the API listens on inside the process/container.
PORT=8080

# Root directory for all persisted state: SQLite database, artifacts, documents,
# browser profiles, backups, plugins and the generated encryption key.
DATA_DIR=./data

# Log verbosity: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# Directory holding the compiled dashboard, served at "/".
WEB_DIR=./public

# Comma-separated list of allowed CORS origins. Only needed when the Vite dev
# server runs separately from the API; the packaged build serves both from one origin.
CORS_ORIGINS=http://localhost:5173

# Set to true (or 1) to disable the background worker and scheduler. Useful for
# tests, CLI runs and read-only inspection of an existing database.
DISABLE_WORKERS=false

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# 32-byte key, hex encoded (64 characters), used to encrypt secret settings such
# as job-board credentials. Generate one with:
#
#   openssl rand -hex 32
#
# If left empty, the app generates a key on first boot and stores it at
# $DATA_DIR/.encryption-key (mode 0600). Set it explicitly when you want the key
# managed outside DATA_DIR, e.g. for containers with ephemeral volumes.
#
# WARNING: losing this key makes every stored secret permanently unrecoverable.
# There is no recovery path and no backup copy anywhere else. Back it up, and
# never change it while encrypted settings exist.
ENCRYPTION_KEY=

# Bearer token required by every route under /api. There are no accounts and no
# passwords: one self-hosted instance, one secret.
#
# If left empty, the app generates one on first boot, stores it at
# $DATA_DIR/.api-token (mode 0600) and prints it at startup. Read it with either:
#
#   docker compose logs app | grep 'API token:'
#   docker compose exec app cat /data/.api-token
#
# Paste it into the dashboard's unlock screen once; it is kept in localStorage.
# For scripts: Authorization: Bearer <token>  (or the X-Api-Token header).
# Set it explicitly here to pin a value that survives losing the volume.
# Minimum 16 characters — anything shorter is rejected at startup.
API_TOKEN=

# Set to false to disable API authentication entirely.
#
# ONLY appropriate when something else in front of this port authenticates for
# you — a reverse proxy with basic auth, mTLS or an SSO forward-auth. Note that
# Caddy's basic_auth and nginx's auth_basic occupy the same Authorization header
# the token uses, so either have the proxy inject X-Api-Token, or turn auth off
# here and let the proxy be the only boundary.
#
# DANGER: AUTH_ENABLED=false together with HOST/APP_BIND widened off loopback
# puts your resume, name, email, phone, every stored LLM prompt containing them,
# your application screenshots and your signed-in job-board sessions on the
# network, with nothing whatsoever in the way. Either alone is defensible; both
# at once is not.
AUTH_ENABLED=true

# ---------------------------------------------------------------------------
# Attended browsing
# ---------------------------------------------------------------------------
#
# Attended mode opens ONE visible browser window that every collector shares.
# You sign in to LinkedIn and Indeed there yourself, once, and the profile on
# disk keeps the session — no cookies to export, no tokens to paste. Both sites
# challenge and rate-limit a scripted login, which is why this exists.
#
# It needs a screen. The Docker image ships one (Xvfb) plus a noVNC viewer, so
# the window shows up inside the dashboard; a bare-metal install uses your own
# desktop and leaves this off by default.

# Seeds browser.attended on FIRST BOOT only. Afterwards the dashboard
# (Settings > Browser) is authoritative and this is ignored. Docker Compose
# defaults it to true.
# BROWSER_ATTENDED=true

# Which session a collector or application run actually uses, seeded on first
# boot only:
#   attended  the shared window you signed in to by hand. The credential vault
#             is never read, so nothing needs pasting and a stale pasted cookie
#             can never overwrite a login you made yourself.
#   stored    the classic pasted-session path, one profile per provider. Works
#             headlessly with no screen.
#   auto      follow BROWSER_ATTENDED. The application default.
# Docker Compose pins this to `attended`, since the image ships the screen.
# BROWSER_SESSION_STRATEGY=attended

# Viewer the dashboard embeds for the attended window's screen. Empty on a
# desktop install — the window is already on your monitor. Loaded by YOUR
# browser, so it must be host-reachable, not a container-internal address.
# REMOTE_VIEW_URL=http://localhost:6080/vnc.html

# ---------------------------------------------------------------------------
# Docker Compose only (read by docker-compose.yml, not by the app)
# ---------------------------------------------------------------------------

# Host port mapped to the app container's port 8080.
APP_PORT=8080

# Interface that port is published on. Loopback by default. Widening it is the
# deliberate act that puts the dashboard on your LAN; see AUTH_ENABLED above for
# the one combination you must never use with it.
# APP_BIND=127.0.0.1

# Host port serving noVNC — the attended browser's screen.
NOVNC_PORT=6080

# Interface that port is published on. Loopback by default and it should stay
# there: anyone who can reach it can drive a browser that is signed in to your
# LinkedIn and Indeed accounts. Set VNC_PASSWORD before widening it.
# NOVNC_BIND=127.0.0.1

# Password required by the VNC server. Empty means none, which is safe only
# while NOVNC_BIND stays on loopback.
# VNC_PASSWORD=

# Set to 0 to skip the virtual screen entirely and run purely headless.
# VIRTUAL_DISPLAY=1

# Resolution of the virtual screen the attended browser is drawn on.
# SCREEN_GEOMETRY=1920x1080x24

# Host port mapped to the optional Ollama container. Started with:
#   docker compose --profile llm up -d
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# Frontend tooling only (read by apps/web configs, not by the app at runtime)
# ---------------------------------------------------------------------------

# API origin the Vite dev server proxies to. Default: http://localhost:8080
# VITE_API_URL=http://localhost:8080

# Point the Playwright e2e suite at an already-running instance instead of
# letting it start its own dev server.
# E2E_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Host prerequisites (no env vars — listed here because they change behaviour)
# ---------------------------------------------------------------------------
#
# LaTeX resume rendering
#   Resumes are LaTeX compiled to PDF with the deedy-resume-openfont class.
#   The class uses fontspec, so it needs XeLaTeX — pdflatex cannot build it.
#     Debian/Ubuntu: apt install texlive-xetex texlive-latex-extra \
#                        texlive-fonts-recommended latexmk
#     Arch:          pacman -S texlive-xetex texlive-latex texlive-latexextra \
#                        texlive-fontsrecommended texlive-binextra
#   Or drop a `tectonic` binary on PATH. Without any engine the API still runs:
#   the .tex is saved and every compile reports the engine is missing.
#
# LaTeX sandbox (strongly recommended)
#   Install `bubblewrap`. Resume LaTeX is attacker-influenced and TeX is
#   Turing-complete, so the regex denylist in front of the engine is a filter,
#   not a boundary — bubblewrap's mount namespace is what actually prevents a
#   document reading DATA_DIR and returning the encryption key inside the PDF.
#   The API logs loudly at startup when it is absent. In Docker this also needs
#   the security_opt entries in docker-compose.yml.
#
# Browser-driven collectors
#   LinkedIn and Indeed drive a real browser; the HTTP-only collectors
#   (Greenhouse, Lever, Ashby, …) do not. Run once:
#     npx playwright install chromium
#   Without it those two sources fail with a message naming this command.
#
# VPN exit location (optional)
#   Settings > VPN can switch which country the collectors browse from. The
#   `protonvpn` backend needs the Proton VPN Linux client installed and signed
#   in on the HOST — it drives NetworkManager, so it does not work from inside
#   the container. nmcli / wg_quick / command backends are available for a
#   tunnel you already manage.
