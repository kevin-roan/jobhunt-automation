# deedy-automation environment
#
# Copy to .env and edit. Every value below is optional: the defaults shown are
# what the code uses when the variable is unset. Nothing here is sent anywhere -
# the whole stack runs on this host.
#
#   cp .env.example .env
#
# Only the variables in this file are read by the application. Anything else you
# add is ignored.

# ---------------------------------------------------------------------------
# Runtime (read by apps/api/src/config/env.ts)
# ---------------------------------------------------------------------------

# Runtime mode: development | production | test. Affects logging and error detail.
NODE_ENV=production

# Interface the API binds to. Use 127.0.0.1 to refuse connections from the LAN.
HOST=0.0.0.0

# Port the API listens on inside the process/container.
PORT=8080

# Root directory for all persisted state: SQLite database, artifacts, documents,
# browser profiles, backups, plugins and the generated encryption key.
DATA_DIR=./data

# Log verbosity: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# Directory holding the compiled dashboard, served at "/".
WEB_DIR=./public

# Comma-separated list of allowed CORS origins. Only needed when the Vite dev
# server runs separately from the API; the packaged build serves both from one origin.
CORS_ORIGINS=http://localhost:5173

# Set to true (or 1) to disable the background worker and scheduler. Useful for
# tests, CLI runs and read-only inspection of an existing database.
DISABLE_WORKERS=false

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# 32-byte key, hex encoded (64 characters), used to encrypt secret settings such
# as job-board credentials. Generate one with:
#
#   openssl rand -hex 32
#
# If left empty, the app generates a key on first boot and stores it at
# $DATA_DIR/.encryption-key (mode 0600). Set it explicitly when you want the key
# managed outside DATA_DIR, e.g. for containers with ephemeral volumes.
#
# WARNING: losing this key makes every stored secret permanently unrecoverable.
# There is no recovery path and no backup copy anywhere else. Back it up, and
# never change it while encrypted settings exist.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Docker Compose only (read by docker-compose.yml, not by the app)
# ---------------------------------------------------------------------------

# Host port mapped to the app container's port 8080.
APP_PORT=8080

# Host port mapped to the optional Ollama container. Started with:
#   docker compose --profile llm up -d
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# Frontend tooling only (read by apps/web configs, not by the app at runtime)
# ---------------------------------------------------------------------------

# API origin the Vite dev server proxies to. Default: http://localhost:8080
# VITE_API_URL=http://localhost:8080

# Point the Playwright e2e suite at an already-running instance instead of
# letting it start its own dev server.
# E2E_BASE_URL=http://localhost:5173
