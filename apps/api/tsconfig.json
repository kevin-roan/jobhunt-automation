{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM types are needed for the callbacks passed to page.evaluate(), which
    // execute inside the browser rather than in Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "tests/**/*"]
}
