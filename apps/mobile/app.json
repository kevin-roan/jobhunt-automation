{
  "expo": {
    "name": "Deedy",
    "slug": "deedy-automation",
    "scheme": "deedy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0d1017",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.deedy.automation",
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.deedy.automation",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#0d1017"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7c85f5",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabasePublishableKey": "",
      "router": {
        "origin": false
      }
    }
  }
}
