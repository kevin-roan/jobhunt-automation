# Copy to .env and fill in. Both values are safe to ship inside the app bundle:
# the anon/publishable key only ever grants what row level security allows, and
# every table is confined to user_id = auth.uid().
#
# NEVER put the Supabase service role / secret key here. Anything with the
# EXPO_PUBLIC_ prefix is inlined into the JavaScript bundle at build time, so a
# service key placed here is readable by anyone who unpacks the app and would
# hand them full read/write access to every user's data, bypassing RLS. The
# service key belongs only in the local server's own .env on the host machine.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
